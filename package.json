{
  "name": "anton",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch --hot ./src/main.ts",
    "fmt": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "build": "bun build --compile --env disable --target=bun-linux-x64 src/main.ts --outfile ./build/main"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.4",
    "zod": "^4.4.3"
  }
}
