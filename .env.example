# NOTE: Do NOT wrap variable values in quotes (e.g. TOKEN=value, NOT TOKEN="value")
# Docker's env_file reader imports quotes literally, causing connection errors.

# Discord Bot Token
TOKEN=

# Spotify Credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SoundCloud Credentials
SOUNDCLOUD_CLIENT_ID=

# yt-dlp executable
YTDLP_PATH=yt-dlp

# Playback Limits
MAX_PLAYLIST_TRACKS=100
MAX_QUEUE_TRACKS=200

# Logging
LOG_LEVEL=info
LOG_PRETTY=false
